{
  "name": "fc27-career-companion",
  "version": "27.0.1",
  "description": "FIFA Analytics — analytics companion for EA FC Career Mode",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bump": "node scripts/bump-version.js",
    "test": "node scripts/license/test_license.js && node scripts/test_depth_chart.js && node scripts/test_legacy_data.js",
    "check": "node --check main.js && node --check js/app.js && node --check js/depth_chart.js && node --check js/academy_tracker.js && node --check js/license.js && node --check js/license_ui.js && node --check js/player_editor.js && node --check js/player_editor_ui.js && node --check js/preload.js",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "build": {
    "appId": "com.fifa.companion.fc27",
    "productName": "FIFA Analytics FC27",
    "win": {
      "target": "nsis",
      "icon": "assets/app-icon/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FIFA Analytics FC27",
      "installerIcon": "assets/app-icon/icon.ico",
      "uninstallerIcon": "assets/app-icon/icon.ico"
    },
    "files": [
      "main.js",
      "index.html",
      "js/**/*",
      "schema.sql",
      "assets/**/*"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "mastroja",
      "repo": "fifa-analytics-fc27"
    }
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "electron-updater": "^6.8.9",
    "sql.js": "^1.14.2"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true
  }
}
